# Copy with `make env` (scripts/gen-env.sh), which replaces every secret with random values.
# `make env` and `make up` refuse to run while .env still contains a `changeme` value.

# Moodle
MOODLE_VERSION=v5.3.0
MOODLE_PORT=8080
# Subnet of the internal backend network. Change it if it overlaps a network on your host;
# `make configure-plugin` derives Moodle's curl allow/block lists from it.
BACKEND_SUBNET=172.28.0.0/24
MOODLE_WWWROOT=http://localhost:8080
MOODLE_SITE_NAME=Moodle local stack
MOODLE_ADMIN_PASSWORD=changeme-7f3a9c2e1b
MOODLE_ADMIN_EMAIL=admin@example.com

# Shared password for the demo teacher accounts created by `make demo-data` (documented, not a secret)
DEMO_USER_PASSWORD=Demo.Teacher.2026

# MySQL
MYSQL_ROOT_PASSWORD=changeme-4d8e2a6f0c
MYSQL_DATABASE=moodle
MYSQL_USER=moodle
MYSQL_PASSWORD=changeme-9b1c5e7a3d

# Read-only analytics user (column-level SELECT on docker/db/analytics-tables.txt, applied by db-grants)
ANALYTICS_DB_USER=analytics_ro
ANALYTICS_DB_PASSWORD=changeme-2e6a8d4f1b

# Analytics
ANALYTICS_SALT=changeme-5c9f3b7e2a
# HMAC key shared with the Moodle plugin. /ask refuses every request while it is empty.
ASKDATA_SHARED_SECRET=changeme-8a4d1f6c3e
ASKDATA_REPLAY_WINDOW_S=300

# Ollama. Default model needs about 9 GB of RAM (or a GPU). On a CPU-only machine with
# 8 GB use qwen2.5-coder:7b; qwen2.5-coder:1.5b (about 1 GB) is only good for smoke tests.
# Run `make init-model` after changing it.
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
# Seconds for all model calls of one question. Keep it below the plugin timeout (180 s).
OLLAMA_TIMEOUT_S=150
# Questions answered at the same time; more get 503 busy. DuckDB memory peaks at
# ASK_CONCURRENCY x DUCKDB_MEMORY_LIMIT.
ASK_CONCURRENCY=2
EXAMPLES_TOP_K=6
# Profiles started by a plain `docker compose up`: cpu, or gpu for an NVIDIA host.
COMPOSE_PROFILES=cpu

EXPORT_FORMAT=duckdb
REFRESH_MINUTES=15
MAX_ROWS=200
ANALYTICS_URL=http://analytics:8000
